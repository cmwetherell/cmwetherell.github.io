# Copy to `.env` and fill in real values. `.env` is git-ignored -- never commit it.
# Loaded by python-dotenv (see chessSim/utils.py and chessSim/olympiadDB.py).

# --- Postgres (Neon) : simulation storage the website reads ---
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_HOST=your-project.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DATABASE=verceldb

# --- Optional : pinged after an upload so the site drops cached data ---
# Defaults to https://www.pawnalyze.com/revalidate if unset.
REVALIDATE_URL=https://www.pawnalyze.com/revalidate

# --- Legacy (older scrapers); leave unset unless you use those scripts ---
# USERNAME=
# PASSWORD=
# COLLECTION=
# DB=
